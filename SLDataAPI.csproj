<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- CS8002锛氬己绛惧悕绋嬪簭闆嗗紩鐢ㄦ湭绛惧悕绋嬪簭闆嗏€斺€旀父鎴?DLL / 0Harmony 绛夎繍琛屾椂渚濊禆鏈氨鏃犲己鍚嶇О锛屽睘棰勬湡 -->
    <NoWarn>CS0618;CS1591;CS8002</NoWarn>

    <!-- 寮哄悕绉扮鍚嶏細鏈湴瀛樺湪 key.snk锛堜笉鍏ュ簱锛夋椂鍚敤 -->
    <SignAssembly Condition="Exists('key.snk')">true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="Exists('key.snk')">key.snk</AssemblyOriginatorKeyFile>

    <!--
      缂栬瘧鏈熷紩鐢ㄨ矾寰勶紙榛樿鎸囧悜鏈満瀹夎鐩綍锛涘叾瀹冩満鍣ㄧ敤 -p: 瑕嗙洊锛夛細
        -p:SCPSL_DIR="D:\...\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed"
        -p:LABAPI_DIR="C:\Users\...\AppData\Roaming\SCP Secret Laboratory\LabAPI"

      鈿狅笍 璁稿彲璇佽鏄庯細娓告垙绋嬪簭闆嗭紙Assembly-CSharp 绛夛級绂佹浜屾鍒嗗彂锛?
      鍥犳浠撳簱涓嶆惡甯﹁繖浜?DLL锛涚紪璇戦渶瑕佹湰鏈哄凡瀹夎 SCP:SL 涓撶敤鏈嶅姟鍣紙鑷甫 LabApi.dll锛夈€?
    -->
    <SCPSL_DIR Condition="'$(SCPSL_DIR)' == ''">D:\SteamLibrary\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</SCPSL_DIR>
    <LABAPI_DIR Condition="'$(LABAPI_DIR)' == ''">$(USERPROFILE)\AppData\Roaming\SCP Secret Laboratory\LabAPI</LABAPI_DIR>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <!-- 璇煶褰曢煶鎵撳寘锛圫ystem.IO.Compression.FileSystem 鎻愪緵 ZipFile锛?-->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- 娓告垙 + LabAPI 绋嬪簭闆嗭細缂栬瘧鏈熷紩鐢ㄦ湰鏈哄畨瑁呯洰褰曪紝杩愯鏃剁敱娓告垙鎻愪緵锛屼笉鎵撳寘 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SCPSL_DIR)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SCPSL_DIR)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SCPSL_DIR)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror.Components">
      <HintPath>$(SCPSL_DIR)\Mirror.Components.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SCPSL_DIR)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SCPSL_DIR)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(SCPSL_DIR)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SCPSL_DIR)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SSS 鏂囨湰杈撳叆妗嗭紙SSPlaintextSetting锛夌殑 ContentType 鍙傛暟鏉ヨ嚜 TextMeshPro -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(SCPSL_DIR)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(SCPSL_DIR)\CommandSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LabApi">
      <HintPath>$(SCPSL_DIR)\LabApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>$(SCPSL_DIR)\NorthwoodLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(SCPSL_DIR)\Pooling.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>$(SCPSL_DIR)\YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(LABAPI_DIR)\dependencies\global\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>


  <!-- Sample plugin is a separate project; do not compile into SLDataAPI.dll -->
  <ItemGroup>
    <Compile Remove="examples/**" />
    <None Include="examples/**" />
  </ItemGroup>
</Project>
